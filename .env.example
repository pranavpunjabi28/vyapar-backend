DATABASE_URL=jdbc:postgresql://localhost:5432/vyapar
DATABASE_USERNAME=vyapar
DATABASE_PASSWORD=vyapar
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Local HTTP only. Shared and production environments must set this to true and use HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_NAME=vyapar_refresh
INVITATION_HOURS=72
STORAGE_ENABLED=true
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=vyapar-media
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_FILE_SIZE_BYTES=5242880
REPORT_MAX_RANGE_DAYS=366
REPORT_MAX_EXPORT_ROWS=100000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
